/* style33.css - Visual styling for Delulu Detector */

body {
    font-family: Verdana, sans-serif;
    margin: 0;
    background-color: #dfffe0;
    color: #083b0a;
}

.container {
    max-width: 600px;
    margin: 50px auto;
    background-color: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    text-align: center;
}

h1 {
    color: #2e8b57;
}

input[type=number] {
    padding: 10px;
    font-size: 16px;
    margin: 10px 0;
    width: 60%;
}

button {
    padding: 10px 20px;
    font-size: 16px;
    margin: 10px;
    background-color: #2e8b57;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background-color: #256444;
}

.question {
    text-align: left;
    margin: 15px 0 5px 0;
}

.options {
    margin-bottom: 15px;
}

.result {
    margin-top: 20px;
    font-weight: bold;
    color: #2e8b57;
}
